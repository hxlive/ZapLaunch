// 功能页面公共控件（设置页 / 属性页共用）—— 数值见 app/docs/设计规格.md 第 7.1 节。
// 铁律（坑 11/12，已踩 4 次）：组件内部位置一律显式写 x/y；组件顶层不引用 parent，
// 尺寸/位置由装配处给；布局内要居中的元素显式算 x。

import { Palette } from "palette.slint";

export global IconRenderer {
    pure callback scaled(image, int) -> image;
    pure callback title(int) -> image;
    pure callback logo() -> image;
}

export component TitleIconImage inherits Image {
    private property <physical-length> physical-edge: min(root.width, root.height);
    source: IconRenderer.title(round(root.physical-edge / 1phx));
    image-fit: contain;
}

export component NativeIconImage inherits Image {
    in property <image> original;
    private property <physical-length> physical-edge: min(root.width, root.height);
    source: IconRenderer.scaled(root.original, round(root.physical-edge / 1phx));
    image-fit: contain;
}

export component LetterIcon inherits Rectangle {
    in property <string> letter;
    in property <color> tint;
    border-radius: self.width / 4;
    background: root.tint;
    Text {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        text: root.letter;
        color: white;
        font-size: parent.height * 0.48;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------------------------------------------------------------------------
// 按钮：kind = 0 次要（透明底 + 边框）/ 1 主按钮（accent 底白字）
// 规格：高 32 r8，padding 0 14，13px/600
// ---------------------------------------------------------------------------
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> enabled: true;

    callback clicked();

    width: label.preferred-width + 28px;
    height: 32px;
    // 根节点保留为可复用组件，透明度放进绘制层，避免编译器逐处展开按钮。
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        border-radius: 8px;
        opacity: root.enabled ? 1 : 0.45;
        background: root.kind == 1
            ? (tap.pressed ? Palette.accentActive : (tap.has-hover ? Palette.accentHover : Palette.accent))
            : (tap.has-hover ? Palette.hoverBg : transparent);
        border-width: focus.has-focus ? 2px : (root.kind == 1 ? 0px : 1px);
        border-color: focus.has-focus ? Palette.accent : Palette.plBorder;
    
        label := Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.kind == 1 ? Palette.onAccent : Palette.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    tap := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// 危险文字按钮：13px/600 #D63B43，无底无边（属性页「删除」）
// ---------------------------------------------------------------------------
export component DangerLink inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: label.preferred-width;
    height: 32px;
    background: transparent;

    label := Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: tap.has-hover ? Palette.danger.brighter(0.15) : Palette.danger;
        vertical-alignment: center;
    }

    tap := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// 开关：轨道 40×22 r11（off switchOff / on accent），滑块 18×18 圆 top2
// ---------------------------------------------------------------------------
export component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Palette.accent : Palette.switchOff;
    animate background { duration: 120ms; }

    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Palette.switchKnob;
        animate x { duration: 120ms; }
    }

    TouchArea {
        clicked => { root.toggled(!root.checked); }
        mouse-cursor: pointer;
    }
}

// ---------------------------------------------------------------------------
// 分区标题：11px/600 muted（设计稿 --section-title）
// ---------------------------------------------------------------------------
export component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.ink;
    height: 20px;
    vertical-alignment: center;
}

// ---------------------------------------------------------------------------
// 简版标题栏（设置 / 属性 / 关于）：同源应用图标 24×24 + 标题 13/600 + 关闭 46×40
// 拖动：整条标题栏可拖（由宿主接 drag-start）
// ---------------------------------------------------------------------------
export component SimpleTitleBar inherits Rectangle {
    in property <string> title-text;
    callback close-clicked();
    callback drag-start();

    height: 40px;
    background: Palette.surface;

    TitleIconImage {
        x: 14px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        image-fit: contain;
    }

    Text {
        x: 46px;
        y: 0;
        width: parent.width - 46px - 46px;
        height: parent.height;
        text: root.title-text;
        font-size: 13px;
        font-weight: 600;
        color: Palette.ink;
        vertical-alignment: center;
    }

    // 关闭按钮 46×40，悬停变红（Windows 惯例）
    close_bg := Rectangle {
        x: parent.width - 46px;
        y: 0;
        width: 46px;
        height: 40px;
        background: close_tap.has-hover ? Palette.closeHover : transparent;

        Path {
            width: 14px;
            height: 14px;
            x: (parent.width - 14px) / 2;
            y: (parent.height - 14px) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: close_tap.has-hover ? #FFFFFF : Palette.muted;
            stroke-width: 1.8px;
            commands: "M 6 6 L 18 18 M 18 6 L 6 18";
        }

        close_tap := TouchArea {
            clicked => { root.close-clicked(); }
            mouse-cursor: pointer;
        }
    }

    // 拖动热区：标题栏除关闭按钮外的区域
    drag_tap := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 46px;
        height: parent.height;
        mouse-cursor: default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag-start();
            }
        }
    }
}

// ---------------------------------------------------------------------------
// 下拉选择行（设置页 ⑩-c「单击托盘图标」）
// 规格：行高 44 + 上边线；左主/副文字；右下拉框 120×32 r8；浮层项高 32
// 坑 13：Scrim（收起热区）必须盖住整窗，所以要由装配处把内容容器在窗口里的
//        偏移传进来（offset-x / offset-y），否则点别处收不起来。
// ---------------------------------------------------------------------------
export component SelectRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <string> value;
    in property <[string]> options;
    in property <length> field-width: 120px;
    in property <length> popup-height-limit: 640px;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;
    callback selected(string);
    callback selected-index(int);

    in-out property <bool> open: false;

    in property <bool> show-line: true;

    height: 63px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Palette.line;
        visible: root.show-line;
    }

    Text {
        x: 0;
        y: 12px;
        width: parent.width - root.field-width - 20px;
        height: 18px;
        text: root.title;
        font-size: 13px;
        color: Palette.ink;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 0;
        y: 34px;
        width: parent.width - root.field-width - 20px;
        height: 17px;
        text: root.subtitle;
        font-size: 12px;
        color: Palette.muted;
        vertical-alignment: center;
        overflow: elide;
    }

    // 下拉框（点击展开 / 收起）
    Rectangle {
        x: parent.width - root.field-width;
        y: (parent.height - 32px) / 2;
        width: root.field-width;
        height: 32px;
        border-radius: 8px;
        background: Palette.plBg;
        border-width: 1px;
        border-color: Palette.panelBorder;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 20px - 18px;
            height: parent.height;
            text: root.value;
            overflow: elide;
            font-size: 13px;
            color: Palette.ink;
            vertical-alignment: center;
        }
        Path {
            x: parent.width - 14px - 8px;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: Palette.muted;
            stroke-width: 1.8px;
            commands: "M 6 9 L 12 15 L 18 9";
        }

        box_tap := TouchArea {
            clicked => { root.open = !root.open; }
            mouse-cursor: pointer;
        }
    }

    // 收起热区（在下层；盖住整窗，点哪都能收起浮层）
    if root.open: TouchArea {
        x: -root.offset-x;
        y: -root.offset-y;
        width: 480px;
        height: 640px;
        clicked => { root.open = false; }
    }

    // 浮层（在上层）
    if root.open: Rectangle {
        x: parent.width - root.field-width;
        y: 40px;
        width: root.field-width;
        height: min(root.options.length * 32px, root.popup-height-limit);
        clip: true;
        border-radius: 8px;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.plBorder;

        Flickable {
        x: 0; y: 0; width: parent.width; height: parent.height;
        content-width: self.width;
        content-height: root.options.length * 32px;
        for opt[i] in root.options: Rectangle {
            x: 0;
            width: parent.width;
            y: i * 32px;
            height: 32px;
            background: item_tap.has-hover ? Palette.hoverBg : transparent;

            Text {
                x: 10px;
                y: 0;
                width: parent.width - 20px;
                height: parent.height;
                text: opt;
                overflow: elide;
                font-size: 13px;
                color: Palette.ink;
                vertical-alignment: center;
            }

            item_tap := TouchArea {
                clicked => {
                    root.value = opt;
                    root.open = false;
                    root.selected(opt);
                    root.selected-index(i);
                }
                mouse-cursor: pointer;
            }
        }
        }
    }
}

// ---------------------------------------------------------------------------
// 热键录制行（设置页 ⑩-c「呼出热键」）
// 规格：行高 32；label 66 + 输入框（kbd 风格 13/600）+ 右侧「录制 / 取消」按钮
// 录制态：输入框显示「按下组合键…」，FocusScope 捕获 Ctrl/Alt/Shift + 键；
//         空格显示 Space；不带修饰键的单键无效（全局热键必须有修饰键，否则会吞正常输入）
// ---------------------------------------------------------------------------
export component HotkeyRow inherits Rectangle {
    in property <string> label;
    in-out property <string> hotkey;
    // 录制态由宿主控制：真正的按键捕获是系统级键盘钩子（zaplaunch-sys::tray），
    // 因为 **带 Ctrl/Alt 的组合键在 Slint 里拿不到 text**——Windows 不为
    // Ctrl+字母 产生字符消息，FocusScope 的 KeyEvent.text 是空的（2026-10-22 实测）。
    in-out property <bool> recording: false;
    callback changed(string);
    callback record-clicked();

    height: 32px;
    background: transparent;

    Text {
        x: 0;
        y: 0;
        width: 66px;
        height: parent.height;
        text: root.label;
        font-size: 13px;
        color: Palette.muted;
        vertical-alignment: center;
    }

    Rectangle {
        x: 66px + 12px;
        y: 0;
        width: parent.width - 66px - 12px - 8px - 56px;
        height: parent.height;
        border-radius: 8px;
        background: Palette.plBg;
        border-width: 1px;
        border-color: root.recording ? Palette.accent : Palette.panelBorder;

        Text {
            x: 10px;
            y: 0;
            width: parent.width - 20px;
            height: parent.height;
            text: root.recording ? "按下组合键…" : root.hotkey;
            font-size: 13px;
            font-weight: 600;
            color: root.recording ? Palette.muted : Palette.kbdText;
            vertical-alignment: center;
        }
    }

    ActionButton {
        x: parent.width - self.width;
        y: 0;
        text: root.recording ? "取消" : "录制";
        kind: 0;
        clicked => { root.record-clicked(); }
    }
}

// ---------------------------------------------------------------------------
// 双按钮行（设置页 ⑩-d「导入 / 导出」）
// ---------------------------------------------------------------------------
export component DualActionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> secondary-text;
    in property <string> primary-text;
    callback secondary-clicked();
    callback primary-clicked();

    in property <bool> show-line: true;

    height: 63px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Palette.line;
        visible: root.show-line;
    }

    Text {
        x: 0;
        y: 12px;
        width: parent.width - 160px;
        height: 18px;
        text: root.title;
        font-size: 13px;
        color: Palette.ink;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 0;
        y: 34px;
        width: parent.width - 160px;
        height: 17px;
        text: root.subtitle;
        font-size: 12px;
        color: Palette.muted;
        vertical-alignment: center;
        overflow: elide;
    }

    primary := ActionButton {
        x: parent.width - self.width;
        y: (parent.height - 32px) / 2;
        text: root.primary-text;
        kind: 0;
        clicked => { root.primary-clicked(); }
    }
    secondary := ActionButton {
        x: primary.x - 8px - self.width;
        y: (parent.height - 32px) / 2;
        text: root.secondary-text;
        kind: 0;
        clicked => { root.secondary-clicked(); }
    }
}

// ---------------------------------------------------------------------------
// 表单行：label 66 + 输入框（高 32 r8 plBg 底 + 1px 边框），间距 12
// 占位文字：text 为空时显示 placeholder（TextInput 无 placeholder 属性，规格 6.5）
// ---------------------------------------------------------------------------
export component FormField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> editable: true;

    height: 32px;
    background: transparent;

    Text {
        x: 0;
        y: 0;
        width: 66px;
        height: parent.height;
        text: root.label;
        font-size: 13px;
        color: Palette.muted;
        vertical-alignment: center;
    }

    Rectangle {
        x: 66px + 12px;
        y: 0;
        width: parent.width - 66px - 12px;
        height: parent.height;
        border-radius: 8px;
        background: Palette.plBg;
        border-width: 1px;
        border-color: Palette.panelBorder;

        placeholder_txt := Text {
            x: 10px;
            y: 0;
            width: parent.width - 20px;
            height: parent.height;
            text: root.placeholder;
            font-size: 13px;
            color: Palette.muted;
            vertical-alignment: center;
            visible: root.text == "" && !input.has-focus;
        }

        input := TextInput {
            x: 10px;
            y: 0;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.text;
            font-size: 13px;
            color: Palette.ink;
            vertical-alignment: center;
            enabled: root.editable;
            single-line: true;
        }
    }
}
