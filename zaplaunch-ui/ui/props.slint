// 按钮属性页（420×506，展开 420×622）：名称、目标、参数、工作目录、图标、独立快捷键。

import { Palette } from "palette.slint";
import { ActionButton, DangerLink, FormField, HotkeyRow, SimpleTitleBar, NativeIconImage, LetterIcon, SelectRow, Toggle } from "widgets.slint";

export component PropsWindow inherits Window {
    title: root.editing ? "按钮属性" : (root.copying ? "新建副本" : "新建按钮");
    width: 420px;
    height: root.advanced ? 622px : 506px;
    background: Palette.surface;
    no-frame: true;
    default-font-family: "Microsoft YaHei";

    in-out property <string> button-label: "";
    in-out property <string> button-target: "";
    in-out property <string> button-params: "";
    in-out property <string> button-work-dir: "";
    in-out property <string> button-icon: "";
    in-out property <string> button-hotkey: "";
    in-out property <bool> recording: false;

    // true = 编辑现有按钮；false = 新建（隐藏删除入口，标题随之变化）。
    in property <bool> editing: true;
    in-out property <string> group-name: "";
    in property <[string]> group-names;
    in-out property <int> group-index;
    in property <int> source-group-index;
    private property <bool> group-changed: root.group-index != root.source-group-index;
    in property <string> icon-cmds: "";
    in property <color> icon-tint: Palette.muted;
    in property <bool> has-native-icon: false;
    in property <image> native-icon;
    in property <string> icon-letter;
    callback preview-icon();
    changed button-target => { root.preview-icon(); }
    changed button-label => { root.preview-icon(); }
    changed button-icon => { root.preview-icon(); }

    in property <bool> copying: false;
    in property <int> nav-position: 0;
    in property <int> nav-count: 0;
    in-out property <int> window-state: 0;
    in-out property <bool> launch-on-startup: false;
    in-out property <bool> advanced: false;
    in-out property <bool> icon-menu: false;
    in property <bool> icon-busy: false;
    in property <string> icon-status;
    callback navigate(int);
    callback duplicate();
    callback icon-action(int);
    callback layout-changed();
    changed advanced => { root.layout-changed(); }
    callback save-clicked();
    callback delete-clicked();
    callback cancel-clicked();
    callback close-clicked();
    callback drag-start();
    callback record-hotkey();
    callback clear-hotkey();

    // ---- 标题栏 40 ----
    SimpleTitleBar {
        x: 0;
        y: 0;
        width: parent.width;
        title-text: root.editing ? "按钮属性" : (root.copying ? "新建副本" : "新建按钮");
        close-clicked => { root.close-clicked(); }
        drag-start => { root.drag-start(); }
    }

    // ---- 头部：标准 48×48 图标预览 + 名称 14/600 + 副文字 11 muted ----
    Rectangle {
        x: 14px;
        y: 53px;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: root.has-native-icon ? transparent : Palette.plBg;
        border-width: root.has-native-icon ? 0px : 1px;
        border-color: Palette.plBorder;

        TouchArea { x: 0; y: 0; width: parent.width; height: parent.height;
            clicked => { root.icon-menu = !root.icon-menu; } mouse-cursor: pointer; }
        if root.has-native-icon : NativeIconImage {
            width: 48px;
            height: 48px;
            x: 0px;
            y: 0px;
            original: root.native-icon;
            image-fit: contain;
        }

        if !root.has-native-icon && root.icon-letter != "" : LetterIcon {
            x: 0; y: 0; width: 48px; height: 48px;
            letter: root.icon-letter; tint: root.icon-tint;
        }
        if !root.has-native-icon && root.icon-letter == "" : Path {
            width: 24px;
            height: 24px;
            x: (parent.width - 24px) / 2;
            y: (parent.height - 24px) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: Palette.dark ? root.icon-tint.brighter(0.35) : root.icon-tint;
            stroke-width: 1.8px;
            commands: root.icon-cmds;
        }
    }
    Text {
        x: 72px;
        y: 53px;
        width: parent.width - 72px - 14px;
        height: 20px;
        text: root.button-label;
        font-size: 14px;
        font-weight: 600;
        color: Palette.ink;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.editing : Rectangle {
        x: 14px; y: 108px; width: parent.width - 28px; height: 30px;
        background: transparent;
        Text {
            x: 0; y: 0; width: parent.width - 155px; height: parent.height;
            text: root.group-changed ? "保存后移至所选分组" : (root.nav-position + 1) + " / " + root.nav-count + " · 切换时保存修改";
            font-size: 11px; color: Palette.muted; vertical-alignment: center;
        }
        ActionButton { x: parent.width - 146px; y: 0; text: "上一项";
            enabled: !root.group-changed && root.nav-position > 0; clicked => { root.navigate(-1); } }
        ActionButton { x: parent.width - 70px; y: 0; text: "下一项";
            enabled: !root.group-changed && root.nav-position + 1 < root.nav-count; clicked => { root.navigate(1); } }
    }
    // ---- 表单 6 行：y146 起，每行高32，间距10 ----
    FormField {
        x: 14px;
        y: 146px;
        width: parent.width - 28px;
        label: "名称";
        text <=> root.button-label;
        placeholder: "显示在磁贴下方的名字";
    }
    FormField {
        x: 14px;
        y: 188px;
        width: parent.width - 28px;
        label: "目标";
        text <=> root.button-target;
        placeholder: "程序 / 文件夹 / 网址 / 系统命令";
    }
    FormField {
        x: 14px;
        y: 230px;
        width: parent.width - 28px;
        label: "参数";
        text <=> root.button-params;
        placeholder: "（可留空）";
    }
    FormField {
        x: 14px;
        y: 272px;
        width: parent.width - 28px;
        label: "工作目录";
        text <=> root.button-work-dir;
        placeholder: "（可留空，默认继承）";
    }
    FormField {
        x: 14px;
        y: 314px;
        width: parent.width - 102px;
        label: "图标";
        text <=> root.button-icon;
        placeholder: "自动获取 / 图标路径 / 内置图标名";
    }
    HotkeyRow {
        x: 14px;
        y: 356px;
        width: parent.width - 92px;
        label: "快捷键";
        hotkey <=> root.button-hotkey;
        recording <=> root.recording;
        record-clicked => { root.record-hotkey(); }
    }
    ActionButton {
        x: parent.width - 70px;
        y: 356px;
        text: "清除";
        kind: 0;
        clicked => { root.clear-hotkey(); }
    }

    ActionButton { x: parent.width - 80px; y: 314px; text: "更改…";
        clicked => { root.icon-menu = !root.icon-menu; } }
    ActionButton { x: 14px; y: 398px; text: root.advanced ? "收起选项" : "启动选项…";
        clicked => { root.advanced = !root.advanced; root.icon-menu = false; } }
    if root.editing : ActionButton { x: parent.width - 88px; y: 398px; text: "复制…";
        clicked => { root.duplicate(); } }
    Text { x: 14px; y: root.advanced ? 548px : 432px; width: parent.width - 28px; height: 20px;
        text: root.icon-status; font-size: 11px; color: Palette.muted; overflow: elide; }

    // ---- 底栏 44 ----
    Rectangle {
        x: 0;
        y: parent.height - 44px;
        width: parent.width;
        height: 44px;
        background: Palette.footBg;

        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Palette.line; }

        DangerLink {
            x: 14px;
            y: (parent.height - 32px) / 2;
            visible: root.editing;
            text: "删除";
            clicked => { root.delete-clicked(); }
        }

        save := ActionButton {
            x: parent.width - 14px - self.width;
            y: (parent.height - 32px) / 2;
            text: "保存";
            kind: 1;
            clicked => { root.save-clicked(); }
        }
        cancel := ActionButton {
            x: save.x - 10px - self.width;
            y: (parent.height - 32px) / 2;
            text: "取消";
            kind: 0;
            clicked => { root.cancel-clicked(); }
        }
    }
    if root.advanced : Rectangle {
        x: 14px; y: 430px; width: parent.width - 28px; height: 112px;
        background: transparent;
        Text { x: 0; y: 77px; width: parent.width; height: 18px;
            text: "后台工具可选隐藏；部分程序自行决定窗口状态";
            font-size: 11px; color: Palette.muted; }
        Text { x: 0; y: 54px; width: parent.width - 55px; height: 22px;
            text: "随 ZapLaunch 启动运行"; font-size: 12px; color: Palette.ink; vertical-alignment: center; }
        Toggle { x: parent.width - 40px; y: 54px; checked: root.launch-on-startup;
            toggled(v) => { root.launch-on-startup = v; } }
        SelectRow { x: 0; y: 0; width: parent.width; height: 50px;
            title: "目标窗口"; subtitle: ""; show-line: false;
            offset-x: 14px; offset-y: 430px;
            options: ["默认", "最小化", "最大化", "隐藏"];
            value: root.window-state == 1 ? "最小化" : root.window-state == 2 ? "最大化" : root.window-state == 3 ? "隐藏" : "默认";
            selected(v) => { root.window-state = v == "最小化" ? 1 : v == "最大化" ? 2 : v == "隐藏" ? 3 : 0; }
        }
    }
    SelectRow {
        x: 72px; y: 75px; width: parent.width - 86px; height: 30px;
        title: "分组"; subtitle: ""; show-line: false;
        field-width: 240px; popup-height-limit: root.height - 127px;
        offset-x: 72px; offset-y: 75px;
        options: root.group-names;
        value <=> root.group-name;
        selected-index(i) => { root.group-index = i; root.icon-menu = false; }
    }
    if root.icon-menu : TouchArea {
        x: 0; y: 0; width: root.width; height: root.height;
        clicked => { root.icon-menu = false; }
    }
    if root.icon-menu : Rectangle {
        x: 92px; y: 348px; width: parent.width - 106px; height: 110px;
        background: Palette.surface; border-radius: 8px; border-width: 1px; border-color: Palette.plBorder;
        ActionButton { x: 8px; y: 4px; text: "自动获取";
            clicked => { root.icon-action(0); root.icon-menu = false; } }
        ActionButton { x: 8px; y: 39px; text: "选择 PNG / ICO…";
            clicked => { root.icon-action(1); root.icon-menu = false; } }
        ActionButton { x: 8px; y: 74px; text: root.icon-busy ? "正在获取…" : "重新获取";
            enabled: !root.icon-busy;
            clicked => { root.icon-action(2); root.icon-menu = false; } }
        ActionButton { x: parent.width - 62px; y: 4px; text: "收起";
            clicked => { root.icon-menu = false; } }
    }

}
